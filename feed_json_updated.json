test \u3067\u691c\u8a3c\u3059\u308b\u30c6\u30b9\u30c8\u30a4\u30f3\u30d5\u30e9 HLD\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/architecture/dip-sip-ptf-validation-high-level-design-concepts.png", "date_modified": "2026-06-03T18:06:37+00:00", "date_published": "2026-05-12T04:12:51+00:00", "authors": [], "tags": []}, {"id": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design-internals/", "url": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design-internals/", "title": "DIP=SIP PTF \u691c\u8a3c \u5185\u90e8\u5b9f\u88c5\uff08\u30d1\u30b1\u30c3\u30c8\u4ed5\u69d8 / \u30d1\u30e9\u30e1\u30fc\u30bf\uff09", "content_html": "DIP=SIP PTF \u691c\u8a3c\u30c6\u30b9\u30c8\u306e dip_sip.py \u30d1\u30e9\u30e1\u30fc\u30bf\u3068\u9001\u53d7\u4fe1\u30d1\u30b1\u30c3\u30c8\u4ed5\u69d8\uff08DIP=SIP \u306e\u307e\u307e L3 \u30eb\u30fc\u30c6\u30a3\u30f3\u30b0\u3001TTL/HL \u304c 1 \u6e1b\u3063\u3066\u53d7\u4fe1\u3055\u308c\u308b\uff09\u3092\u6574\u7406\u3059\u308b\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/architecture/dip-sip-ptf-validation-high-level-design-internals.png", "date_modified": "2026-06-03T18:06:37+00:00", "date_published": "2026-05-12T04:12:51+00:00", "authors": [], "tags": []}, {"id": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design-limitations/", "url": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design-limitations/", "title": "DIP=SIP PTF \u691c\u8a3c \u5236\u9650\u4e8b\u9805\u3068 HLD-\u5b9f\u88c5\u4e56\u96e2\uff08pytest \u79fb\u884c\uff09", "content_html": "DIP=SIP PTF \u691c\u8a3c\u30c6\u30b9\u30c8\u306e\u5236\u9650\u4e8b\u9805\u30fb\u5e72\u6e09\u3059\u308b\u6a5f\u80fd\u30fb\u30c8\u30e9\u30d6\u30eb\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3001\u304a\u3088\u3073 ansible/ptftests \u304b\u3089 sonic-mgmt/tests/ipfwd/test_dip_sip.py (pytest) \u3078\u306e\u79fb\u884c\u306b\u4f34\u3046 HLD-\u5b9f\u88c5\u4e56\u96e2\u3092\u6574\u7406\u3059\u308b\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/architecture/dip-sip-ptf-validation-high-level-design-limitations.png", "date_modified": "2026-06-03T18:06:37+00:00", "date_published": "2026-05-12T04:12:51+00:00", "authors": [], "tags": []}, {"id": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design-operations/", "url": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design-operations/", "title": "DIP=SIP PTF \u691c\u8a3c \u904b\u7528\uff08\u30d5\u30a1\u30a4\u30eb\u69cb\u6210 / \u524d\u51e6\u7406 / \u5b9f\u884c\uff09", "content_html": "DIP=SIP PTF \u691c\u8a3c\u30c6\u30b9\u30c8\u306e sonic-mgmt \u914d\u4e0b\u30d5\u30a1\u30a4\u30eb\u69cb\u6210\u3068 Ansible \u524d\u51e6\u7406\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3001\u5b9f\u884c\u30b3\u30de\u30f3\u30c9\u3092\u6574\u7406\u3059\u308b\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/architecture/dip-sip-ptf-validation-high-level-design-operations.png", "date_modified": "2026-06-03T18:06:37+00:00", "date_published": "2026-05-12T04:12:51+00:00", "authors": [], "tags": []}, {"id": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design/", "url": "https://aoki-taquan.github.io/sonic-unofficial-docs/architecture/dip-sip-ptf-validation-high-level-design/", "title": "DIP=SIP PTF \u691c\u8a3c\u30c6\u30b9\u30c8", "content_html": "DIP=SIP PTF \u691c\u8a3c\u30c6\u30b9\u30c8 \u2014 \u300cDIP\uff08destination IP\uff09\u3068 SIP\uff08source IP\uff09\u304c\u540c\u3058\u300dL3 \u30d1\u30b1\u30c3\u30c8\u3092 SONiC \u30b9\u30a4\u30c3\u30c1\u304c\u6b63\u3057\u304f\u30eb\u30fc\u30c6\u30a3\u30f3\u30b0\u3067\u304d\u308b\u304b