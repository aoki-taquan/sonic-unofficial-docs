rence/cli/config-default-route.png", "date_modified": "2026-06-06T21:03:32+00:00", "date_published": "2026-05-11T08:13:00+00:00", "authors": [], "tags": []}, {"id": "https://aoki-taquan.github.io/sonic-unofficial-docs/reference/config-db/auto-techsupport-feature/", "url": "https://aoki-taquan.github.io/sonic-unofficial-docs/reference/config-db/auto-techsupport-feature/", "title": "AUTO_TECHSUPPORT_FEATURE \u30c6\u30fc\u30d6\u30eb", "content_html": "AUTO_TECHSUPPORT_FEATURE \u30c6\u30fc\u30d6\u30eb \u2014 AUTO_TECHSUPPORT (GLOBAL) \u3067\u5b9a\u7fa9\u3057\u305f\u30a4\u30d9\u30f3\u30c8\u99c6\u52d5 techsupport \u306e\u6319\u52d5\u3092\u3001FEATURE (docker) \u5358\u4f4d\u3067\u30aa\u30fc\u30d0\u30fc\u30e9\u30a4\u30c9\u3059\u308b\u30c6\u30fc\u30d6\u30eb\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/reference/config-db/auto-techsupport-feature.png", "date_modified": "2026-06-06T21:03:32+00:00", "date_published": "2026-05-11T08:00:11+00:00", "authors": [], "tags": []}, {"id": "https://aoki-taquan.github.io/sonic-unofficial-docs/reference/config-db/feature/", "url": "https://aoki-taquan.github.io/sonic-unofficial-docs/reference/config-db/feature/", "title": "FEATURE \u30c6\u30fc\u30d6\u30eb", "content_html": "FEATURE \u30c6\u30fc\u30d6\u30eb \u2014 SONiC \u306e\u6a5f\u80fd docker\uff08bgp\u3001teamd\u3001snmp\u3001sflow\u3001telemetry \u7b49\uff09\u306e\u6709\u52b9\u5316\u3001\u81ea\u52d5\u518d\u8d77\u52d5\u3001\u8d77\u52d5\u9045\u5ef6\u3001scope\uff08global / per-asic / per-dpu\uff09\u3001Kubernetes \u7ba1\u7406\u5207\u308a\u66ff\u3048\u3092\u4fdd\u6301\u3059\u308b\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/reference/config-db/feature.png", "date_modified": "2026-06-06T21:03:32+00:00", "date_published": "2026-05-09T19:02:24+00:00", "authors": [], "tags": []}]}