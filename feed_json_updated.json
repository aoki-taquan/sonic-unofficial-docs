tml": "QoS / Buffer \u306e\u904b\u7528 \u2014 \u300c\u30a2\u30d7\u30ea\u304c\u8a70\u307e\u308b\u300d\u300cPFC \u3067\u6b62\u307e\u3063\u305f\u300d\u300c\u30ad\u30e5\u30fc\u304c\u6368\u3066\u3066\u3044\u308b\u300d\u3068\u8a00\u308f\u308c\u305f\u3068\u304d\u306b\u3001\u3069\u306e\u30b3\u30de\u30f3\u30c9\u3092\u3069\u306e\u9806\u756a\u3067\u53e9\u304f\u304b\u3001\u3092\u6574\u7406\u3057\u307e\u3059\u3002", "image": "https://aoki-taquan.github.io/sonic-unofficial-docs/assets/images/social/topics/08-qos-buffer/operations.png", "date_modified": "2026-06-06T03:57:03+00:00", "date_published": "2026-05-11T01:34:48+00:00", "authors": [], "tags": []}]}